# ===== Обязательные переменные окружения =====

# Подключение к PostgreSQL (на Replit устанавливается автоматически
# при провижене БД через панель Replit)
#DATABASE_URL=postgresql://adminbf:12qwasZxcv@localhost:5432/BFond
DATABASE_URL=postgresql://div.devops:12qwasZxcv@localhost:5432/BFond

# Секрет для подписи cookie-сессий (любая длинная случайная строка)
SESSION_SECRET=change-me-to-a-long-random-string

# ===== Учётные данные администратора =====
# Используются для создания первого пользователя при старте сервера.
# После первого запуска поменяйте пароль через админ-панель или прямо в БД.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# ===== Сетевые порты (на Replit задаются автоматически) =====
# Если поднимаете на своём сервере, укажите свободные порты.
# PORT — порт API-сервера
PORT=8080
# BASE_PATH — префикс пути фронтенда. Для прод-деплоя оставьте "/"
BASE_PATH=/

# ===== Среда =====
NODE_ENV=development

# ===== Почта для уведомлений =====
# Куда отправлять заявки с сайта по умолчанию при первом создании настроек.
PUBLIC_EMAIL=info@example.org
ADMIN_NOTIFICATION_EMAIL=admin@example.org

# SMTP для отправки писем с сайта
SMTP_HOST=smtp.example.org
SMTP_PORT=465
SMTP_USER=mailer@example.org
SMTP_PASS=change-me
SMTP_FROM="Мечты добрых сердец <mailer@example.org>"
